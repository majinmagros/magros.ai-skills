{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .fusion-harness/scripts/cost-tracker.py pretool"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .fusion-harness/scripts/cost-tracker.py posttool"
          }
        ]
      }
    ]
  }
}